[Unit]
Description=metiq Auth Expiry Monitor
After=network.target

[Service]
Type=oneshot
# setup-auth-system.sh symlinks the repo's scripts/ directory here.
ExecStart=%h/.local/share/metiq/scripts/auth-monitor.sh
Environment=WARN_HOURS=2
# NOTIFY_NTFY / NOTIFY_PHONE (and WARN_HOURS overrides) are written here by
# setup-auth-system.sh; the leading '-' tolerates a missing file.
EnvironmentFile=-%h/.config/metiq/auth-monitor.env

[Install]
WantedBy=default.target
