[Unit]
Description=metiq daemon — Nostr-native AI agent
Documentation=https://github.com/metiq/metiq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Bare-metal profile assumptions:
# - Binary: ~/.local/bin/metiqd (install or symlink the daemon there)
# - Env file: optional ~/.metiq/.env for secrets and runtime configuration
# - Writable paths: ~/.metiq, ~/.local/share/metiq, and this unit's private /tmp
# - Optional dependencies such as Python+uv, Node.js, Chromium/Xvfb, and Docker CLI
#   are provided by the host OS when tools/plugins require them.
EnvironmentFile=-%h/.metiq/.env

ExecStart=%h/.local/bin/metiqd

# Restart policy
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening (user service — no root needed)
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.metiq %h/.local/share/metiq /tmp

[Install]
WantedBy=default.target
