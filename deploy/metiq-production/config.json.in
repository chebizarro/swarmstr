{
  "version": 1,
  "dm": {
    "policy": "disabled",
    "reply_scheme": "nip17"
  },
  "relays": {
    "read": {{METIQ_RELAYS_JSON}},
    "write": {{METIQ_RELAYS_JSON}}
  },
  "agent": {
    "default_model": "echo",
    "default_autonomy": "observe",
    "default_authority": {
      "exec": "block",
      "network": "block",
      "write": "block"
    }
  },
  "nostr_channels": {
    "_example-room": {
      "kind": "nip29",
      "enabled": false,
      "group_address": "wss://relay.example.com'example-room",
      "config": {
        "planningOnlyContinuation": false
      }
    }
  },
  "control": {
    "require_auth": true,
    "allow_unauth_methods": [],
    "admins": {{SOULFACTORY_ADMINS_JSON}},
    "legacy_token_fallback": false
  },
  "storage": {
    "encrypt": true
  },
  "heartbeat": {
    "enabled": false
  }
}
